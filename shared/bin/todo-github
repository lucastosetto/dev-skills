#!/usr/bin/env bash
# GitHub part of /todo, no model needed:
#   todo-github [mentions_since=YYYY-MM-DD, default 3 days ago]
# Prints JSON: {login, reviews: PRs that request my review by name (not only through a team), that
# nobody has approved yet and that a person (not a bot) opened, mine: my open PRs, mentions: open issues/PRs
# mentioning me}. PRs carry review decision, mergeable, CI rollup and unresolved threads whose last
# comment is not mine. Uses the gh account currently active.
# One paged GraphQL search per list, run in parallel: one big query hits GitHub's 10s timeout (502).
set -euo pipefail
since=${1:-$(date -v-3d +%F 2>/dev/null || date -d '3 days ago' +%F)}
login=$(gh api user -q .login)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

pr_fields='... on PullRequest {
  url number title isDraft updatedAt additions deletions headRefName reviewDecision mergeable
  author { __typename login } repository { nameWithOwner }
  reviewRequests(first: 20) { nodes { requestedReviewer { ... on User { login } } } }
  latestReviews(first: 20) { nodes { state } }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
  reviewThreads(first: 50) { nodes { isResolved comments(last: 1) { nodes { author { login } } } } }
}'
item_fields='... on PullRequest { url title updatedAt author { login } repository { nameWithOwner } }
  ... on Issue { url title updatedAt author { login } repository { nameWithOwner } }'

search() {  # name, query, fields: pages of 20 (bigger pages time out), at most 5, each retried once
  local q="query(\$q: String!, \$after: String) { search(type: ISSUE, query: \$q, first: 20, after: \$after) {
    pageInfo { hasNextPage endCursor } nodes { $3 } } }" after="" page
  for page in 1 2 3 4 5; do
    gh api graphql -f q="$2" ${after:+-f after="$after"} -f query="$q" > "$tmp/$1.$page" 2>/dev/null ||
      { sleep 2; gh api graphql -f q="$2" ${after:+-f after="$after"} -f query="$q" > "$tmp/$1.$page"; }
    [ "$(jq -r .data.search.pageInfo.hasNextPage "$tmp/$1.$page")" = true ] || break
    after=$(jq -r .data.search.pageInfo.endCursor "$tmp/$1.$page")
  done
  jq -s '[.[].data.search.nodes[]]' "$tmp/$1".* > "$tmp/$1"
}

search reviews "is:pr is:open archived:false review-requested:$login" "$pr_fields" &
search mine "is:pr is:open archived:false author:$login" "$pr_fields" &
search mentions "is:open archived:false mentions:$login -author:$login updated:>=$since" "$item_fields" &
for job in $(jobs -p); do wait "$job"; done

jq -n --arg l "$login" --slurpfile r "$tmp/reviews" --slurpfile m "$tmp/mine" --slurpfile x "$tmp/mentions" '
  def pr: {url, repo: .repository.nameWithOwner, number, title, author: .author.login, draft: .isDraft,
    at: .updatedAt, add: .additions, del: .deletions, branch: .headRefName, review: .reviewDecision,
    mergeable, ci: .commits.nodes[0].commit.statusCheckRollup.state,
    waiting_threads: [.reviewThreads.nodes[] | select(.isResolved | not)
      | select(.comments.nodes[0].author.login != $l)] | length};
  {login: $l, reviews: [$r[0][] | select(.author.__typename != "Bot")
      | select(any(.reviewRequests.nodes[]; .requestedReviewer.login == $l))
      | select(any(.latestReviews.nodes[]; .state == "APPROVED") | not) | pr], mine: [$m[0][] | pr],
    mentions: [$x[0][] | {url, repo: .repository.nameWithOwner, title, author: .author.login, at: .updatedAt}]}'
