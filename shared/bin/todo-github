#!/usr/bin/env bash
# GitHub part of /todo in one GraphQL call, no model needed:
#   todo-github [mentions_since=YYYY-MM-DD, default 3 days ago]
# Prints JSON: {login, reviews: PRs waiting for my review, mine: my open PRs, mentions: open issues/PRs
# mentioning me}. PRs carry review decision, mergeable, CI rollup and unresolved threads whose last
# comment is not mine. Uses the gh account currently active.
set -euo pipefail
since=${1:-$(date -v-3d +%F 2>/dev/null || date -d '3 days ago' +%F)}
login=$(gh api user -q .login)

gh api graphql \
  -f q1="is:pr is:open archived:false review-requested:$login" \
  -f q2="is:pr is:open archived:false author:$login" \
  -f q3="is:open archived:false mentions:$login -author:$login updated:>=$since" \
  -f query='
query($q1: String!, $q2: String!, $q3: String!) {
  reviews: search(type: ISSUE, query: $q1, first: 50) { nodes { ...pr } }
  mine: search(type: ISSUE, query: $q2, first: 50) { nodes { ...pr } }
  mentions: search(type: ISSUE, query: $q3, first: 30) {
    nodes {
      ... on PullRequest { url title updatedAt author { login } repository { nameWithOwner } }
      ... on Issue { url title updatedAt author { login } repository { nameWithOwner } }
    }
  }
}
fragment pr on PullRequest {
  url number title isDraft updatedAt additions deletions headRefName reviewDecision mergeable
  author { login } repository { nameWithOwner }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
  reviewThreads(first: 50) { nodes { isResolved comments(last: 1) { nodes { author { login } } } } }
}' | jq --arg l "$login" '
  def pr: {url, repo: .repository.nameWithOwner, number, title, author: .author.login, draft: .isDraft,
    at: .updatedAt, add: .additions, del: .deletions, branch: .headRefName, review: .reviewDecision,
    mergeable, ci: .commits.nodes[0].commit.statusCheckRollup.state,
    waiting_threads: [.reviewThreads.nodes[] | select(.isResolved | not)
      | select(.comments.nodes[0].author.login != $l)] | length};
  .data | {login: $l, reviews: [.reviews.nodes[] | pr], mine: [.mine.nodes[] | pr],
    mentions: [.mentions.nodes[] | {url, repo: .repository.nameWithOwner, title, author: .author.login, at: .updatedAt}]}'
